# Copy to .env (gitignored). OpenCode Go key, see docs/dev/NOTES.md
HARNESS_API_KEY=your-opencode-go-key-here
HARNESS_MODEL=muse-spark-1.3-contributor
HARNESS_BASE_URL=https://opencode.ai/zen/go/v1
HARNESS_USER_AGENT=harness-dev/0.1
HARNESS_TIMEOUT_SECONDS=60
HARNESS_SHELL_TIMEOUT_SECONDS=120
HARNESS_SESSIONS_DB=.harness/sessions.db
HARNESS_INPUT_PRICE_PER_MILLION=0.1
HARNESS_CACHED_INPUT_PRICE_PER_MILLION=0.002
HARNESS_OUTPUT_PRICE_PER_MILLION=0.2
HARNESS_TOOL_OUTPUT_LIMIT_CHARACTERS=2000
HARNESS_TOOL_OUTPUT_DIR=.harness/outputs
HARNESS_COMPACT_AT_TOKENS=4000
HARNESS_KEEP_RECENT_TURNS=2
